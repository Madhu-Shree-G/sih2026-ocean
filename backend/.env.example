# ---------------------------------------------------------------------------
# OceanView3D backend configuration
# Copy to `.env` and edit. Every key is optional; defaults suit local dev.
# All variables use the OCEANVIEW_ prefix.
# ---------------------------------------------------------------------------

# ---- Service --------------------------------------------------------------
OCEANVIEW_ENVIRONMENT=development
OCEANVIEW_DEBUG=false

# ---- Database -------------------------------------------------------------
# SQLite by default (zero setup). Point at PostgreSQL/PostGIS for deployment:
# OCEANVIEW_DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/oceanview

# ---- Geographic domain ----------------------------------------------------
OCEANVIEW_DOMAIN_LAT_MIN=-10.0
OCEANVIEW_DOMAIN_LAT_MAX=26.0
OCEANVIEW_DOMAIN_LON_MIN=55.0
OCEANVIEW_DOMAIN_LON_MAX=100.0

# ===========================================================================
# Firewall / hardening
# ===========================================================================

# Comma-separated. Never use "*" together with credentials.
OCEANVIEW_CORS_ALLOW_ORIGINS=http://localhost:5173,http://localhost:3000
OCEANVIEW_CORS_ALLOW_CREDENTIALS=false

# Host header allow-list (DNS-rebinding defence).
OCEANVIEW_ALLOWED_HOSTS=localhost,127.0.0.1,testserver

# Token-bucket rate limiting, per client IP.
OCEANVIEW_RATE_LIMIT_ENABLED=true
OCEANVIEW_RATE_LIMIT_DEFAULT_PER_MINUTE=240
OCEANVIEW_RATE_LIMIT_HEAVY_PER_MINUTE=40
OCEANVIEW_RATE_LIMIT_BLOCK_SECONDS=30
OCEANVIEW_RATE_LIMIT_MAX_VIOLATIONS=12

# Request hardening.
OCEANVIEW_MAX_REQUEST_BODY_BYTES=1048576
OCEANVIEW_MAX_QUERY_STRING_BYTES=4096
OCEANVIEW_MAX_CONCURRENT_HEAVY_REQUESTS=8

# Payload ceilings - the real resource-exhaustion surface for a gridded API.
OCEANVIEW_MAX_VOLUME_CELLS=40000000
OCEANVIEW_MAX_VOLUME_BYTES=100663296
OCEANVIEW_MAX_TIMESTEPS_PER_REQUEST=60
OCEANVIEW_MAX_TRANSECT_POINTS=512
OCEANVIEW_MAX_DRIFT_PARTICLES=5000
OCEANVIEW_MAX_DRIFT_HOURS=240

# Authentication.
# Admin routes fail closed: without a key set, they are unusable, not open.
# OCEANVIEW_ADMIN_API_KEY=change-me-to-a-long-random-string
# Read endpoints are public by default (the outreach use case in the PS).
OCEANVIEW_REQUIRE_API_KEY=false
# OCEANVIEW_API_KEY=another-long-random-string

# ---- Response cache -------------------------------------------------------
OCEANVIEW_CACHE_ENABLED=true
OCEANVIEW_CACHE_MAX_ENTRIES=128
OCEANVIEW_CACHE_TTL_SECONDS=900

# ===========================================================================
# Deep — the voice agent
# ===========================================================================
# Deep resolves every command with a deterministic grammar: instant, offline,
# and unable to invent an action that does not exist. That tier always runs
# first and needs no configuration.
#
# Setting a key adds a second tier: when the grammar cannot classify an
# utterance at all, Claude answers the open-ended question grounded in the
# on-screen state. It never emits actions directly — it may only propose a
# command phrase, which is re-validated by the grammar before anything runs.
#
# Requires: pip install anthropic
# OCEANVIEW_ANTHROPIC_API_KEY=sk-ant-...
